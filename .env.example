# =====================================================================
# TRIRARA / EXCAVA.OPS — Environment Variables PRODUKSI (Coolify, Dockerfile tunggal)
# Coolify → Application → Environment Variables → "Developer view" → tempel → Save → Redeploy.
# JANGAN commit file .env berisi nilai asli.
# =====================================================================

# ---------- Aplikasi ----------
# Port uvicorn di dalam container. Samakan dengan "Ports Exposes" di Coolify.
PORT=8000
TZ=Asia/Makassar

# ---------- Database MariaDB (WAJIB) ----------
# DB_HOST = "Internal host" resource MariaDB di Coolify (nama container, mis. k8s0wc4g...). Bukan localhost.
DB_HOST=
DB_PORT=3306
DB_DATABASE=trirara
DB_USERNAME=trirara
DB_PASSWORD=
# Alternatif (opsional, menimpa DB_*): URL lengkap
# MARIADB_URL=mysql+asyncmy://USER:PASSWORD@HOST:3306/trirara?charset=utf8mb4

# ---------- Admin pertama (dibuat otomatis bila database belum punya admin) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@trirara.my.id
# Email Google yang otomatis menjadi admin saat login Google (pisahkan koma, opsional)
ADMIN_EMAILS=

# ---------- Keamanan / CORS ----------
CORS_ORIGINS=https://trirara.my.id,https://www.trirara.my.id
# Rahasia endpoint penjadwal /api/cron/* (dipakai scripts/cron_call.py di Coolify Scheduled Tasks)
WEBHOOK_CRON_SECRET=

# ---------- WhatsApp Business Cloud API (kosong = mode simulasi, pesan tidak terkirim) ----------
# Webhook URL di Meta: https://trirara.my.id/api/whatsapp/webhook  (Verify token = WHATSAPP_VERIFY_TOKEN)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# ---------- AI pembaca gambar WA (bukti transfer / foto HM) ----------
# Library dipasang otomatis oleh Dockerfile (build arg INSTALL_AI=1). Kosong = fitur AI nonaktif.
EMERGENT_LLM_KEY=
WA_AI_PROVIDER=gemini
WA_AI_MODEL=gemini-3-flash-preview
WA_AI_CONCURRENCY=1

# ---------- Migrasi sekali jalan dari MongoDB lama (opsional) ----------
# Isi, Redeploy, tunggu log "[migrasi] ... selesai", lalu HAPUS variabel ini dan Redeploy lagi.
# MIGRATE_FROM_MONGO_URL=mongodb://root:PASSWORD@HOST_MONGO:27017/?authSource=admin
# MIGRATE_FROM_MONGO_DB=ttp_ops
# MIGRATE_FROM_MONGO_FORCE=0
