# =====================================================================
# TRIRARA / EXCAVA.OPS — Environment Variables PRODUKSI (Coolify)
# Salin ke Coolify → Application → Environment Variables, lalu isi nilainya.
# JANGAN commit file .env berisi nilai asli.
# =====================================================================

# ---------- Aplikasi ----------
# Port yang di-listen uvicorn. Samakan dengan "Ports Exposes" di Coolify.
PORT=8000

# ---------- Database MariaDB (format standar Coolify) ----------
# DB_HOST = nama host internal resource MariaDB di Coolify (lihat tab "General" database, mis. m4k2abc...)
DB_HOST=
DB_PORT=3306
DB_DATABASE=trirara
DB_USERNAME=trirara
DB_PASSWORD=
# Alternatif (opsional, menimpa DB_*): URL lengkap
# MARIADB_URL=mysql+asyncmy://USER:PASSWORD@HOST:3306/trirara?charset=utf8mb4

# ---------- Admin pertama (dibuat otomatis bila belum ada admin di database) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Email Google yang otomatis menjadi admin (pisahkan koma, opsional)
ADMIN_EMAILS=

# ---------- Keamanan / CORS ----------
# Same-origin (frontend & API satu domain) → cukup isi domain aplikasi Anda.
CORS_ORIGINS=https://trirara.my.id,https://www.trirara.my.id
# Rahasia untuk endpoint penjadwal (cron) — string acak panjang
WEBHOOK_CRON_SECRET=

# ---------- WhatsApp Business Cloud API (kosong = mode simulasi) ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0

# ---------- AI pembaca gambar WA (opsional) ----------
# Library emergentintegrations dipasang otomatis oleh Dockerfile (build arg INSTALL_AI=1). Kosong = fitur AI nonaktif.
EMERGENT_LLM_KEY=

# ---------- Migrasi dari MongoDB lama (opsional, sekali jalan) ----------
# Isi HANYA bila ingin menyalin data dari MongoDB lama; hapus setelah migrasi selesai.
# MIGRATE_FROM_MONGO_URL=mongodb://root:PASSWORD@HOST_MONGO:27017/?authSource=admin
# MIGRATE_FROM_MONGO_DB=ttp_ops
